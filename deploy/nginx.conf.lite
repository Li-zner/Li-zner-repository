# ============================================================
# agent_gateway Nginx 精简版 —— 单网关（阿里云小实例，面试/稳定用）
# ============================================================

map $request_uri $is_attack {
    default 0;
    ~*(union\s+(all\s+)?select) 1;
    ~*(select\s+.*\s+from\s+.*\s+where) 1;
    ~*(insert\s+into|delete\s+from|drop\s+table|update\s+.*\s+set) 1;
    ~*(information_schema|pg_sleep|benchmark\s*\() 1;
    ~*(<script|javascript:|onerror\s*=|onload\s*=|alert\s*\() 1;
    ~*(\.\./|\.\.\\|/etc/passwd|base64_encode|eval\s*\() 1;
}

limit_req_zone $binary_remote_addr zone=gw_limit:10m rate=500r/s;
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

# 单网关
upstream gateway_cluster {
    server agent_gateway:10086 max_fails=3 fail_timeout=30s;
}

server {
    listen 80;
    server_tokens off;
    client_max_body_size 20m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    if ($is_attack = 1) {
        return 403;
    }

    limit_conn conn_limit 100;

    location /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location ~ ^/(api/login|api/phone/|auth/github) {
        limit_req zone=auth_limit burst=100 nodelay;
        proxy_pass http://gateway_cluster;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 4;
        proxy_next_upstream_timeout 10s;
    }

    location /static/ {
        proxy_pass http://gateway_cluster;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering on;
        expires 1h;
        proxy_connect_timeout 2s;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 4;
        proxy_next_upstream_timeout 10s;
    }

    location / {
        limit_req zone=gw_limit burst=1000 nodelay;
        proxy_pass http://gateway_cluster;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 4;
        proxy_next_upstream_timeout 10s;
    }
}
