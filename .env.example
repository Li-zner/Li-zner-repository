# ============================================
# ⚠️ 安全须知：此文件仅作示例，请勿直接使用。
# 生产环境请将实际密钥放在 /etc/agent_gateway/.env
# ============================================

# ===== 必填：JWT & Session 密钥（必须设置强随机字符串）=====
JWT_SECRET=your-strong-jwt-secret-here
SESSION_SECRET_KEY=your-strong-session-secret-here

# ===== 必填：管理员凭据（ADMIN_PASSWORD 为空将拒绝启动，fail loudly）=====
# 未设置 ADMIN_PASSWORD 时应用拒绝启动（安全设计，防空密码管理员）
ADMIN_PASSWORD=your-strong-admin-password-here
ADMIN_USERNAME=admin
# 可选：管理员手机号（用于注册/绑定）
ADMIN_PHONE=

# ===== 数据库 =====
DATABASE_URL=postgresql://agent_user:your_db_password@postgres:5432/agent_gateway

# ===== 密钥类（请填入真实值）=====
DIFY_API_KEY=app-xxx
DEEPSEEK_API_KEY=sk-xxx
AMAP_API_KEY=xxx

# ===== Dify 配置 =====
DIFY_API_URL=http://docker-api-1:5001/v1/chat-messages

# ===== Ollama 本地 =====
OLLAMA_URL=http://localhost:11434/api/generate

# ===== 网关配置 =====
PORT=10086
TIMEOUT_PRIMARY=3.0
TIMEOUT_FALLBACK=5.0
TIMEOUT_LOCAL=10.0

# ===== CORS（生产环境请填写具体域名）=====
CORS_ORIGINS=http://localhost:10088,http://localhost:10086,http://localhost:10089,http://localhost:10090
