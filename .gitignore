# ============================================================
# agent_gateway .gitignore
# 原则：密钥、数据、备份、本地产物一律不进版本库
# ============================================================

# ---------- 密钥与配置（绝不提交） ----------
.env
.env.*
!.env.example
!.env.lite.example
*.env
etc/
login*.json
*.pem
*.key
*.p12
*.jks
secrets*.json
*_secret*.json
*_credentials*.json

# ---------- 数据库备份与数据 ----------
backups/
*.sql
*.sql.gz
*.dump
*.dmp
# CDC 建表参考脚本需要入库（例外）
!scripts/cdc_setup.sql
*.tar.gz
*.tgz
*.db
*.sqlite
*.sqlite3
backup.log
*.log
tempo_data/
uploads/
agent_gateway.tar.gz

# ---------- CDC 变更日志（落盘 SSD） ----------
cdc_journal/

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 命令/系统产物 ----------
start
nul
-d
-H
exporter.log
*.exe
*.bin

# ---------- 前端构建产物 ----------
node_modules/
dist/
*.min.js.map

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
.wiki/.obsidian/

# ---------- Office 临时文件 ----------
~$*.docx
~$*.doc
~$*.xlsx
~$*.pptx

