# 精简部署环境变量模板（1 GiB 小实例）
# 用法：复制为 deploy/.env.lite 并填必填项；部署脚本会随机生成 SESSION_SECRET_KEY/JWT_SECRET
#
# ===== 必填 =====
# 数据库连接串（与下方 POSTGRES_PASSWORD 保持一致；host 用服务名 postgres 不可改）
DATABASE_URL=postgresql://agent_user:agent_pass@postgres:5432/agent_gateway
# 会话/密钥（必填，缺失则容器启动失败 fail loudly）
SESSION_SECRET_KEY=
JWT_SECRET=
# admin 登录密码（必填）
ADMIN_PASSWORD=
# DeepSeek API Key（必填，网关核心依赖）
DEEPSEEK_API_KEY=

# ===== PostgreSQL（改密码时需与 DATABASE_URL 同步）=====
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_pass
POSTGRES_DB=agent_gateway

# ===== 可选（留空用默认）=====
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 公网访问地址（实例公网 IP，供前端/CORS/回调使用）
GATEWAY_PUBLIC_URL=http://your-server-ip:10090
CORS_ORIGINS=http://your-server-ip:10090
# 高德 Key（天气工具，可选）
AMAP_API_KEY=
