{
  "name": "query_hotel",
  "description": "根据目的地和预算推荐酒店",
  "enabled": true,
  "handler": "app.agents.sub_agents",
  "handler_func": "call_sub_agent",
  "parameters": {
    "type": "object",
    "properties": {
      "destination": { "type": "string", "description": "目的地城市" },
      "budget": { "type": "string", "description": "预算范围，如'经济型'或'豪华'" }
    },
    "required": ["destination"]
  }
}
